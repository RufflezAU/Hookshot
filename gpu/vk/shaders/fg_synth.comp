#version 450
// an in-between frame at time t.
//
// (hookshot) Two answers are available for each pixel, and the made frame takes the one whose error on that pixel is
// smaller. Never a mix of the two game frames: a mix is a ghost by definition, and that is what the fog showed.
//
//   the warp   - the last frame back along t of its motion and the new one forward along 1 - t. They sample the same
//                point in the world, so a right vector leaves them equal however soft the content: its error is what
//                they still differ by.
//   the frame  - the newer of the two game frames as it is. Its error is the distance between the copies of a double
//                image, gap(a0, b0).
//
// Both errors are measured on the same pixel in the same units, so a fog bank and a letter are judged alike. The old
// gate was gap(a0, b0) alone - motion times slope - so a fast pan over haze read as "still" and the made frame was the
// plain blend there: a 50% double image. Where the warp is worse than a held frame (a wrong vector, an icon the flow
// moved with the world, a thing hidden in the last frame) the frame is shown instead.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D fa;
layout(binding = 1) uniform sampler2D fb;
layout(binding = 2) uniform sampler2D flow;
layout(binding = 3, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { float t; float safe; float gain; } pc;
vec2 fl(ivec2 q) { return texelFetch(flow, clamp(q, ivec2(0), textureSize(flow, 0) - 1), 0).xy; }
float gap(vec3 x, vec3 y) { const vec3 d = abs(x - y); return max(d.r, max(d.g, d.b)); }
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const float t = pc.t;
    const vec3 a0 = texelFetch(fa, g, 0).rgb, b0 = texelFetch(fb, g, 0).rgb;
    // (hookshot) RX_VK_FRAMEGEN_SAFE: 1 the plain blend of the two game frames (smooth, ghosts by the motion); 2 the last
    // frame held (shown twice: no ghost, no smoothness). 0 and 3 are the warp below - 3 is the default.
    if (pc.safe > 0.5 && pc.safe < 2.5) {
        imageStore(dst, g, vec4(pc.safe > 1.5 ? a0 : mix(a0, b0, t), 1.0));
        return;
    }
    const vec3 near = t < 0.5 ? a0 : b0;   // (at 2x t is exactly 0.5: the newer frame, about to be shown again)
    const float e_still = gap(a0, b0);
    if (e_still <= 0.0) { imageStore(dst, g, vec4(a0, 1.0)); return; }   // (nothing moved here)
    const vec2 p = vec2(g) + 0.5;
    const vec2 fp = p / 16.0 - 0.5;
    const ivec2 i = ivec2(floor(fp));
    const vec2 w = fp - floor(fp);
    const vec2 v = mix(mix(fl(i), fl(i + ivec2(1, 0)), w.x), mix(fl(i + ivec2(0, 1)), fl(i + ivec2(1, 1)), w.x), w.y);
    const vec2 size = vec2(d);
    const vec3 a = textureLod(fa, (p - t * v) / size, 0.0).rgb;
    const vec3 b = textureLod(fb, (p + (1.0 - t) * v) / size, 0.0).rgb;
    const float e_warp = gap(a, b);
    const float gain = (e_still - e_warp) / max(e_still + e_warp, 1.0 / 255.0);
    const float keep = smoothstep(0.0, max(pc.gain, 1e-3), gain);
    imageStore(dst, g, vec4(mix(near, mix(a, b, t), keep), 1.0));
}
