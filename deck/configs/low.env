# Low: the stable texture settings (the 512/64 caps made the intro movie run at 7-11 fps, so they
# are out), with less eviction churn. The look changes come from low.ini (upscaler, sharpness).
RX_VK_VRAM_MB=1200
RX_VK_TEX_MAX_MB=128
RX_VK_TEX_MAX_DIM=1024
RX_VK_EVICT_MIN_MS=3000
RX_VK_MIRROR_MB=192
RX_VK_CHECKPOINTS=1
RX_VK_NOCULL=1
