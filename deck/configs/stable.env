# Texture budget. 1200 MB was the only value that stayed under the driver's allowance in an
# overnight A/B on one Deck (peak 6099 of 6144 MB); 1500 MB was 83 MB over; 2200 MB went over
# badly and RADV paged VRAM to system memory.
RX_VK_VRAM_MB=1200
# Large textures: leave their top levels out above this, so the big ones are not made at all.
RX_VK_TEX_MAX_DIM=1024
RX_VK_TEX_MAX_MB=128
# How long a texture may go unused before it can be evicted. In milliseconds, not presents: at
# 4 fps, 60 presents is 15 seconds, and VRAM ran past the budget between sweeps.
RX_VK_EVICT_MIN_MS=1500
# The mirror of the buffer pools costs VRAM for little on this GPU.
RX_VK_MIRROR_MB=192
# Diagnostic markers: the draw the GPU reached is named if the device is lost.
RX_VK_CHECKPOINTS=1
