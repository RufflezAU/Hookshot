RX_VK_VRAM_MB=2800
RX_VK_TEX_MAX_MB=256
RX_VK_TEX_MAX_DIM=1024
RX_VK_MIRROR_MB=256
# Off: it writes a VK_AMD_buffer_marker before every draw and dispatch, ~2,300 a frame. Diagnostic only.
RX_VK_CHECKPOINTS=0
RX_VK_NOCULL=1
RX_VK_PRECOMPILE=0
HOS_HANDHELD=1
HOS_REALTIME_FLOOR=10
RX_VK_BATCH_IDLE=1
# Frame generation off: at 2x it cost 8.5 ms of GPU a frame (14.3 -> 5.8 ms) and doubled shadows.
RX_VK_FRAMEGEN=0
RX_VK_STAGING_IDLE_S=0
RX_VK_STAGING_KEEP_MB=256
# Sleeps under a millisecond wait on the timer. Not set, they are spun out with yields on Linux, and the game's 11 idle
# job workers each sleep 20 us about 7,600 times a second: 13-26 % of a processor each in Hyrule Field, on 4 cores that
# the frame needs. 0: spun as before.
HOS_SHORT_SLEEP_TIMER=1
# The SVC release spin. At 1 us (the count 64 pauses) the frame was 45.25 -> 44.74 ms; at 20 us, 45.25 -> 36.23.
# It is the code's default too, so this line is only needed by a build older than that change.
HOS_SPIN_US=20
# No core kept free of the game's threads. One of the Deck's four was kept for a replay thread this game does not use,
# and nothing of the game's ran on it. A build with the fix in host/hos_thread.c does this by itself; the line makes an
# older build do it too.
HOS_RESERVE_CORE=0
# The recording was cut every 120 draws -- about 21 cuts a frame, each re-sending all of the state.
# 500 measured replay 14.60 -> 12.87 ms at a matched scene (707 draws, 87 samples, twice).
RX_VK_CHUNK=500
